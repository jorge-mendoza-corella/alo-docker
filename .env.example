# GitHub - Usuario para clonar workspace
GITHUB_USER=tu-usuario-github

# Bitwarden - Contraseña maestra
BW_MASTER_PASSWORD=tu_contraseña_maestra_aqui

# Bitwarden - Client ID
BW_CLIENTID=tu_client_id_aqui

# Bitwarden - Client Secret
BW_CLIENTSECRET=tu_client_secret_aqui

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key_aqui

# OpenClaw (servidor base)
OPENCLAW_HOST=localhost
OPENCLAW_PORT=18789

# Entorno
NODE_ENV=production
