# GitHub - Usuario para clonar workspace
GITHUB_USER=tu-usuario-github

# Bitwarden - Contraseña maestra (ÚNICA variable sensible en .env)
BW_MASTER_PASSWORD=tu_contraseña_maestra_aqui

# Bitwarden - Client ID (obtener de Bitwarden)
BW_CLIENTID=user.dea03998-31c9-4808-97b2-b42d00ff601c

# Bitwarden - Client Secret (obtener de Bitwarden)
BW_CLIENTSECRET=BP4FhiPSrCrLAQwH7RrDqgGk0sxaup

# NOTA: SUPABASE_URL y SUPABASE_KEY se extraen de Bitwarden automáticamente en tiempo de ejecución
# No necesitan estar aquí. El contenedor desbloquea Bitwarden y obtiene las credenciales.

# Entorno
NODE_ENV=production
