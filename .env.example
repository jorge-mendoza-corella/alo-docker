# Bitwarden - Contraseña maestra
BW_MASTER_PASSWORD=tu_contraseña_maestra_aqui

# Bitwarden - Client ID (obtener de Bitwarden)
BW_CLIENTID=tu_client_id_aqui

# Bitwarden - Client Secret (obtener de Bitwarden)
BW_CLIENTSECRET=tu_client_secret_aqui

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key_aqui

# Entorno
NODE_ENV=production
